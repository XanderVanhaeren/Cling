<Window x:Class="Cling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cling"
        xmlns:v="clr-namespace:Cling.Views"
        xmlns:cling="clr-namespace:Cling.Controls"
        mc:Ignorable="d"
        Style="{StaticResource ClingWindow}"
        Title="CL!ng" Height="580" Width="580" ResizeMode="NoResize" Loaded="MainWindow_Loaded">
    <Grid Margin="0,0,0,0">
        <!-- Tabs -->
        <TabControl Style="{StaticResource ClingTabControl}">
            <TabItem Header="Device" Style="{StaticResource ClingTabItemHeader}">
                <v:DeviceView x:Name="DeviceInfoView"/>
            </TabItem>
            <TabItem Header="Memory" Style="{StaticResource ClingTabItemHeader}">
                <v:MemoryView x:Name="MemoryInfoView"/>
            </TabItem>
            <TabItem Header="Performance" Style="{StaticResource ClingTabItemHeader}">
                <v:PerformanceView/>
            </TabItem>
            <TabItem Header="About" Style="{StaticResource ClingTabItemHeader}">
                <v:AboutView/>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
