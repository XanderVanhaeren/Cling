<Application x:Class="Cling.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cling"
             xmlns:cling="clr-namespace:Cling.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Shared CL!ng styling -->
        <Style x:Key="ClingWindow" TargetType="{x:Type Window}">
            <Setter Property="Background" Value="#f2f2f2"/>
            <Setter Property="FontFamily" Value="Segoe UI, Calibri, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Read-only info field (used for computed/device values) -->
        <Style x:Key="ClingTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Calibri, sans-serif"/>
            <Setter Property="Foreground" Value="#2b2b2b"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#c0c0c0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="#333333"/>
            <Setter Property="SelectionBrush" Value="#b0d8ff"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="ClingComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI, Calibri, sans-serif"/>
            <Setter Property="Foreground" Value="#2b2b2b"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#c0c0c0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Bold section header label -->
        <Style x:Key="ClingHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1a1a1a"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Section label next to a value field -->
        <Style x:Key="ClingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Plain body text -->
        <Style x:Key="ClingText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#2b2b2b"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Subtle divider line -->
        <Style x:Key="ClingBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#e8e8e8"/>
            <Setter Property="BorderBrush" Value="#dcdcdc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Button styling -->
        <Style x:Key="ClingButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2b2b2b"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#c0c0c0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Tab control matching the CL!ng tab bar -->
        <Style x:Key="ClingTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#f2f2f2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,4"/>
        </Style>

        <!-- Tab item header matching the CL!ng rounded tabs -->
        <Style x:Key="ClingTabItemHeader" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>
    </Application.Resources>
</Application>