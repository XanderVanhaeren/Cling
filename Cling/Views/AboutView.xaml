<UserControl x:Class="Cling.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center">

            <TextBlock Text="Version 0.02 (build idk)" Foreground="#2b2b2b" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6" HorizontalAlignment="Center"/>
            <TextBlock Text="(not) Copyright © 2026 Xander Vanhaeren." Foreground="#555555" FontSize="13" Margin="0,0,0,18" HorizontalAlignment="Center"/>

            <Button Content="Review App" Style="{StaticResource ClingButton}" Width="160" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        </StackPanel>
    </Grid>
</UserControl>
