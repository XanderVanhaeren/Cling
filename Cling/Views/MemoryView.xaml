<UserControl x:Class="Cling.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cling="clr-namespace:Cling.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,8">
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource ClingText}" Foreground="#a33" Margin="0,2,0,0"/>

        <!-- Common memory properties -->
        <Grid Margin="0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Global Memory" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding GlobalMemory}"/>

            <TextBlock Grid.Row="1" Text="Local Memory" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding LocalMemory}"/>

            <TextBlock Grid.Row="2" Text="Local Memory Type" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding LocalMemoryType}"/>

            <TextBlock Grid.Row="3" Text="Unified Memory with host" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding UnifiedMemoryWithHost}"/>

            <TextBlock Grid.Row="4" Text="Endianness" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Endianness}"/>

            <TextBlock Grid.Row="5" Text="ECC support" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding EccSupport}"/>
        </Grid>

        <!-- Native vector widths -->
        <Grid Margin="0,12,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Native vector width CHAR" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeCharWidth}"/>

            <TextBlock Grid.Row="1" Text="Native vector width SHORT" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeShortWidth}"/>

            <TextBlock Grid.Row="2" Text="Native vector width INT" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeIntWidth}"/>

            <TextBlock Grid.Row="3" Text="Native vector width LONG" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeLongWidth}"/>

            <TextBlock Grid.Row="4" Text="Native vector width FLOAT" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeFloatWidth}"/>

            <TextBlock Grid.Row="5" Text="Native vector width DOUBLE" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeDoubleWidth}"/>

            <TextBlock Grid.Row="6" Text="Native vector width HALF" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeHalfWidth}"/>
        </Grid>

        <!-- Preferred vector widths -->
        <Grid Margin="0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Preferred vector width CHAR" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredCharWidth}"/>

            <TextBlock Grid.Row="1" Text="Preferred vector width SHORT" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredShortWidth}"/>

            <TextBlock Grid.Row="2" Text="Preferred vector width INT" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredIntWidth}"/>

            <TextBlock Grid.Row="3" Text="Preferred vector width LONG" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredLongWidth}"/>

            <TextBlock Grid.Row="4" Text="Preferred vector width FLOAT" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredFloatWidth}"/>

            <TextBlock Grid.Row="5" Text="Preferred vector width DOUBLE" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredDoubleWidth}"/>

            <TextBlock Grid.Row="6" Text="Preferred vector width HALF" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredHalfWidth}"/>
        </Grid>

        <Border Height="24" Background="#f2f2f2" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
