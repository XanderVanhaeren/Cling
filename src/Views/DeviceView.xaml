<UserControl x:Class="Cling.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ClingScrollViewer}">
        <StackPanel Margin="10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section header +  StatusMessage -->
                <TextBlock Grid.Row="0" Text="Common" Style="{StaticResource ClingHeader}" />

                <!-- Common info rows -->
                <Grid Grid.Row="0" Margin="0,20,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Name}"/>

                    <TextBlock Grid.Row="1" Text="Platform" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Platform}"/>

                    <TextBlock Grid.Row="2" Text="Version" Style="{StaticResource ClingLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Version}"/>

                    <TextBlock Grid.Row="3" Text="Vendor" Style="{StaticResource ClingLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Vendor}"/>

                    <TextBlock Grid.Row="4" Text="Type" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Type}"/>
                </Grid>

                <!-- Compute section header -->
                <TextBlock Grid.Row="1" Text="Compute" Style="{StaticResource ClingHeader}"/>

                <!-- Compute info rows -->
                <Grid Grid.Row="1" Margin="0,20,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ComputeUnitsLabel}" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding ComputeUnits}"/>

                    <TextBlock Grid.Row="1" Text="Clock" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Clock}"/>

                    <TextBlock Grid.Row="2" Text="Address space" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding AddressSpace}"/>

                    <TextBlock Grid.Row="3" Text="Maximum Workgroup Size" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding MaxWorkGroupSize}"/>

                    <TextBlock Grid.Row="4" Text="Dimensions" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding WorkItemSizes}"/>

                    <TextBlock Grid.Row="5" Text="Single Precision FMA" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding SinglePrecisionFma}"/>

                    <TextBlock Grid.Row="6" Text="Double Precision Support" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding DoublePrecisionSupport}"/>

                    <TextBlock Grid.Row="7" Text="Local Memory" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding LocalMemory}"/>

                    <TextBlock Grid.Row="8" Text="Local Memory Type" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding LocalMemoryType}"/>

                    <TextBlock Grid.Row="9" Text="Unified Memory with Host" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding UnifiedMemoryWithHost}"/>

                    <TextBlock Grid.Row="10" Text="Endianness" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Endianness}"/>

                    <TextBlock Grid.Row="11" Text="ECC Support" Style="{StaticResource ClingLabel}"/>
                    <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding EccSupport}"/>
                </Grid>
            </Grid>
        </StackPanel>

    </ScrollViewer>

</UserControl>