<UserControl x:Class="Cling.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="14,8">

        <!-- Section header + Intel chip placeholder -->
        <Grid>
            <TextBlock Text="Common" Style="{StaticResource ClingHeader}"/>
        </Grid>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource ClingText}" Foreground="#a33" Margin="0,2,0,0"/>

        <!-- Common info rows -->
        <Grid Margin="0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Name}"/>

            <TextBlock Grid.Row="1" Text="Platform" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Platform}"/>

            <TextBlock Grid.Row="2" Text="Version" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Version}"/>

            <TextBlock Grid.Row="3" Text="Vendor" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Vendor}"/>

            <TextBlock Grid.Row="4" Text="Type" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Type}"/>
        </Grid>

        <!-- Compute section header -->
        <TextBlock Text="Compute" Style="{StaticResource ClingHeader}" Margin="0,12,0,0"/>

        <!-- Compute info rows -->
        <Grid Margin="0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ComputeUnitsLabel}" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding ComputeUnits}"/>

            <TextBlock Grid.Row="1" Text="Clock" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Clock}"/>

            <TextBlock Grid.Row="2" Text="Address space" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding AddressSpace}"/>

            <TextBlock Grid.Row="3" Text="Maximum Workgroup Size" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding MaxWorkGroupSize}"/>

            <TextBlock Grid.Row="4" Text="Dimensions" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding WorkItemSizes}"/>

            <TextBlock Grid.Row="5" Text="Single Precision FMA" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding SinglePrecisionFma}"/>

            <TextBlock Grid.Row="6" Text="Double Precision Support" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding DoublePrecisionSupport}"/>
        </Grid>
    </StackPanel>
</UserControl>
