<UserControl x:Class="Cling.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ClingScrollViewer}">
        <StackPanel Margin="14,8">

            <!-- Section header +  StatusMessage -->
        <Grid>
            <TextBlock Text="Common" Style="{StaticResource ClingHeader}"/>
        </Grid>
            
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource ClingStatusMessage}"/>

        <!-- Common info rows -->
        <Grid Margin="0,6" Background="#1f1f1f">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Name}"/>

            <TextBlock Grid.Row="1" Text="Platform" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Platform}"/>

            <TextBlock Grid.Row="2" Text="Version" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Version}"/>

            <TextBlock Grid.Row="3" Text="Vendor" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Vendor}"/>

            <TextBlock Grid.Row="4" Text="Type" Style="{StaticResource ClingLabel}" Grid.ColumnSpan="2"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Type}"/>
        </Grid>

        <!-- Compute section header -->
        <TextBlock Text="Compute" Style="{StaticResource ClingHeader}" Margin="0,12,0,0"/>

        <!-- Compute info rows -->
        <Grid Margin="0,6" Background="#1f1f1f">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ComputeUnitsLabel}" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding ComputeUnits}"/>

            <TextBlock Grid.Row="1" Text="Clock" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Clock}"/>

            <TextBlock Grid.Row="2" Text="Address space" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding AddressSpace}"/>

            <TextBlock Grid.Row="3" Text="Maximum Workgroup Size" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding MaxWorkGroupSize}"/>

            <TextBlock Grid.Row="4" Text="Dimensions" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding WorkItemSizes}"/>

            <TextBlock Grid.Row="5" Text="Single Precision FMA" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding SinglePrecisionFma}"/>

            <TextBlock Grid.Row="6" Text="Double Precision Support" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding DoublePrecisionSupport}"/>

            <TextBlock Grid.Row="7" Text="Local Memory" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding LocalMemory}"/>

            <TextBlock Grid.Row="8" Text="Local Memory Type" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding LocalMemoryType}"/>

            <TextBlock Grid.Row="9" Text="Unified Memory with Host" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding UnifiedMemoryWithHost}"/>

            <TextBlock Grid.Row="10" Text="Endianness" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding Endianness}"/>

            <TextBlock Grid.Row="11" Text="ECC Support" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding EccSupport}"/>
        </Grid>

        <!-- Native vector widths section -->
        <TextBlock Text="Native Vector Widths" Style="{StaticResource ClingHeader}" Margin="0,12,0,0"/>

        <!-- Native vector widths rows -->
        <Grid Margin="0,6" Background="#1f1f1f">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Char" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeCharWidth}"/>

            <TextBlock Grid.Row="1" Text="Short" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeShortWidth}"/>

            <TextBlock Grid.Row="2" Text="Int" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeIntWidth}"/>

            <TextBlock Grid.Row="3" Text="Long" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeLongWidth}"/>

            <TextBlock Grid.Row="4" Text="Float" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeFloatWidth}"/>

            <TextBlock Grid.Row="5" Text="Double" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding NativeDoubleWidth}"/>
        </Grid>

        <!-- Preferred vector widths section -->
        <TextBlock Text="Preferred Vector Widths" Style="{StaticResource ClingHeader}" Margin="0,12,0,0"/>

        <!-- Preferred vector widths rows -->
        <Grid Margin="0,6" Background="#1f1f1f">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Char" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredCharWidth}"/>

            <TextBlock Grid.Row="1" Text="Short" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredShortWidth}"/>

            <TextBlock Grid.Row="2" Text="Int" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredIntWidth}"/>

            <TextBlock Grid.Row="3" Text="Long" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredLongWidth}"/>

            <TextBlock Grid.Row="4" Text="Float" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredFloatWidth}"/>

            <TextBlock Grid.Row="5" Text="Double" Style="{StaticResource ClingLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ClingTextBox}" Text="{Binding PreferredDoubleWidth}"/>
        </Grid>

    </StackPanel>
    </ScrollViewer>
</UserControl>