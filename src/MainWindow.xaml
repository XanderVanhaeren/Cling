<Window x:Class="Cling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cling"
        xmlns:v="clr-namespace:Cling.Views"
        mc:Ignorable="d"
        Style="{StaticResource ClingWindow}"
        Title="CL!ng" Height="600" Width="600" ResizeMode="NoResize" Loaded="MainWindow_Loaded">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <TabControl Grid.Row="0" Style="{StaticResource ClingTabControl}"  >
            <TabItem Header="Device" Style="{StaticResource ClingTabItemHeader}">
                <v:DeviceView x:Name="DeviceInfoView"/>
            </TabItem>
            <TabItem Header="Memory" Style="{StaticResource ClingTabItemHeader}">
                <v:MemoryView x:Name="MemoryInfoView"/>
            </TabItem>
            <TabItem Header="Performance" Style="{StaticResource ClingTabItemHeader}">
                <v:PerformanceView/>
            </TabItem>
            <TabItem Header="About" Style="{StaticResource ClingTabItemHeader}">
                <v:AboutView Loaded="AboutView_Loaded"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#252525" BorderBrush="#3a3a3a" BorderThickness="1,1,1,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="OpenCL Device" Style="{StaticResource ClingLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="DeviceSelector" Grid.Column="1" Style="{StaticResource ClingComboBox}" DisplayMemberPath="DisplayName" SelectionChanged="DeviceSelector_SelectionChanged"/>
            </Grid>
        </Border>
    </Grid>
</Window>